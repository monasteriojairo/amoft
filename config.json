{
    "clearcore_port": "/dev/ttyACM0",
    "arduino_port": "/dev/ttyUSB0",
    "baud_rate": 115200,
    "m1_enabled": false,
    "simulation_mode": true,
    "auto_sequences": {
        "Demo Cycle": [
            {
                "peripheral": "m0",
                "action": "forward",
                "repeat": 1,
                "dwell_ms": 5000,
                "enable_before": true,
                "stop_after": true,
                "disable_after": true,
                "display": "M0 | Roll Servo | Forward | 5.0s | repeat 1"
            },
            {
                "peripheral": "actuator",
                "action": "extend",
                "repeat": 1,
                "dwell_ms": 8000,
                "enable_before": true,
                "stop_after": false,
                "disable_after": true,
                "display": "Actuator | Extend | 8.0s | repeat 1"
            },
            {
                "peripheral": "actuator",
                "action": "retract",
                "repeat": 1,
                "dwell_ms": 8000,
                "enable_before": true,
                "stop_after": false,
                "disable_after": true,
                "display": "Actuator | Retract | 8.0s | repeat 1"
            },
            {
                "peripheral": "m1",
                "action": "forward",
                "repeat": 1,
                "dwell_ms": 4000,
                "enable_before": true,
                "stop_after": true,
                "disable_after": true,
                "display": "M1 | Tilt Servo | Forward | 4.0s | repeat 1"
            },
            {
                "peripheral": "m1",
                "action": "reverse",
                "repeat": 1,
                "dwell_ms": 4000,
                "enable_before": true,
                "stop_after": true,
                "disable_after": true,
                "display": "M1 | Tilt Servo | Reverse | 4.0s | repeat 1"
            },
            {
                "peripheral": "m0",
                "action": "reverse",
                "repeat": 1,
                "dwell_ms": 4000,
                "enable_before": true,
                "stop_after": true,
                "disable_after": true,
                "display": "M0 | Roll Servo | Reverse | 4.0s | repeat 1"
            }
        ]
    }
}